# Development values. In production: APP_ENV=production, APP_DEBUG=false, an https:// APP_URL,
# then run "php artisan triage:check-deployment" (see "Mise en production" in the README).
APP_NAME=Triage
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL or MariaDB. For a quick local trial, set DB_CONNECTION=sqlite and remove the DB_* lines below.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=triage
# Use a database account reserved to Triage, with a password. Never root in production.
DB_USERNAME=triage
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@triage.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mobile API: minutes before an access token expires (7 days).
SANCTUM_TOKEN_EXPIRATION=10080

# Security (config/security.php)
# Technicians and administrators must enable two-factor authentication.
REQUIRE_2FA_FOR_STAFF=false
# Address of the reverse proxy in front of the application, if any (comma separated).
TRUSTED_PROXIES=
LIMIT_TICKETS_PER_HOUR=20
LIMIT_MESSAGES_PER_MINUTE=10
LIMIT_API_REQUESTS_PER_MINUTE=120

# Days before a resolved ticket is closed automatically.
TICKET_AUTO_CLOSE_DAYS=7

# GDPR: months a closed or resolved ticket keeps its content.
TICKET_RETENTION_MONTHS=24

# AI triage. Leave AI_ENABLED=false to run without any AI (manual triage only).
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_TIMEOUT=30
AI_RATE_LIMIT_PER_MINUTE=20
AI_LOW_CONFIDENCE_THRESHOLD=0.7

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Local model with Ollama (AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
# Plain HTTP is refused when Ollama runs on another machine, unless this is set to true.
OLLAMA_ALLOW_INSECURE=false
OLLAMA_MODEL=llama3.2

VITE_APP_NAME="${APP_NAME}"
